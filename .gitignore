# Generated CAD reports, previews and temporary exports
/cad/output/
/cad/drawings/exports/
/cad/*/exports/

# KiCad local state at any nesting level
**/*.kicad_prl
**/*.lck
**/.history/
**/back/
**/_restore_backup_*/
**/*.bak
**/*.tmp
*~

# Generated simulator and tool logs
*.log
ngspice.log

# Python bytecode and test/type-check caches
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Local Python environments
.venv/
venv/

# Editor and operating-system files
.DS_Store
Thumbs.db
*.swp
*.swo
