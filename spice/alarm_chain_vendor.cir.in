* gazo_analizator: шаблон проверки цепочки на моделях производителей
* Токены @TLV7041_LIB@ и @TLC555_LIB@ заменяются в run_vendor_model_test.sh.
* U2 использует официальную библиотеку PSpice TI для TLV7041.
* DA1 использует модель PSpice TI TLC555 как функциональный аналог КР1006ВИ1.
* КТ3102ГМ приближён универсальной моделью SPICE 2N3904.
* Вход MQ-4 задан параметрическим делителем с приближёнными точками характеристики.
* HA1 представлен нагрузкой 166,7 Ом, а не полной моделью активного зуммера.

.include "@TLV7041_LIB@"
.include "@TLC555_LIB@"

.title Сигнализатор газа: модели компаратора и функционального аналога таймера
.param SOUND_ENABLE=1
.param C_TIMER=4.7u
.param R0_SENSOR=20k
.param RL_SENSOR=20k

VCCSRC VCC 0 DC 5
C3 VCC 0 47u
C_U2 VCC 0 100n

* Приближённый чувствительный элемент MQ-4 по библиотеке Amperka TroykaMQ и
* характеристике Hanwei MQ-4: Rs/R0 ~= 4.4 в чистом воздухе, 1.0 при 1000 ppm
* и 0.6 при 5000 ppm CH4. R0_SENSOR=20k — сценарное значение в диапазоне
* 10k–60k при 1000 ppm. Это не гарантированные параметры каждого модуля.
* Сценарии: 0 — чистый воздух, 1 — 1000 ppm CH4, 2 — 5000 ppm CH4.
VSEL_AIR CTRL_AIR 0 PWL(0 1 0.7999 1 0.8 0 2.3999 0 2.4 1 4 1)
VSEL_1000 CTRL_1000 0 PWL(0 0 0.7999 0 0.8 1 1.5999 1 1.6 0 4 0)
VSEL_5000 CTRL_5000 0 PWL(0 0 1.5999 0 1.6 1 2.3999 1 2.4 0 4 0)
.model SW_GAS SW(Ron=0.1 Roff=1e9 Vt=0.5 Vh=0.1)
R_S_AIR VCC N_S_AIR {4.4*R0_SENSOR}
S_AIR N_S_AIR S CTRL_AIR 0 SW_GAS
R_S_1000 VCC N_S_1000 {R0_SENSOR}
S_1000 N_S_1000 S CTRL_1000 0 SW_GAS
R_S_5000 VCC N_S_5000 {0.6*R0_SENSOR}
S_5000 N_S_5000 S CTRL_5000 0 SW_GAS
RL_S S 0 {RL_SENSOR}

* UREF около 2,4 В. Порог необходимо калибровать для конкретного датчика.
* При R0_SENSOR=20k сценарное напряжение S составляет около 2,50 В при 1000 ppm.
RP1A VCC UREF 5.2k
RP1B UREF 0 4.8k
RHYS DOUT UREF 100k
R1 VCC DOUT 160k
R8 VCC DOUT 2.2k

* Порядок выводов официальной подцепи TI TLV7041: IN+, IN-, OUT, V+, V-.
XU2 UREF S DOUT VCC 0 TLV7041

* Модель 2N3904 — только аналог КТ3102ГМ для функциональной проверки.
R2 DOUT VT1_B 10k
QVT1 RESET VT1_B 0 Q_2N3904
R3 VCC RESET 2k

.model Q_2N3904 NPN(IS=6.734f XTI=3 EG=1.11 VAF=74.03 BF=416.4 NE=1.259 ISE=6.734f IKF=66.78m XTB=1.5 BR=0.7371 NC=2 ISC=0 IKR=0 RC=1 CJC=3.638p MJC=0.3085 VJC=0.75 FC=0.5 CJE=4.493p MJE=0.2593 VJE=0.75 TR=239.5n TF=301.2p ITF=0.4 VTF=4 XTF=2 RB=10)

* Исходные номиналы астабильной цепи.
R4 VCC DISCH 8.2k
R5 DISCH CT 8.2k
C1 CT 0 {C_TIMER}
C2 CTRL555 0 100n

* Порядок выводов модели TI TLC555: THRES, CONT, TRIG, RESET, OUT, DISC, VCC, GND.
* TLC555 — CMOS-аналог, электрически не идентичный биполярному КР1006ВИ1.
XDA1 CT CTRL555 CT RESET OUT DISCH VCC 0 TLC555_6

* Приближённая модель светодиода HL1.
R6 OUT HL1_A 220
D_HL1 HL1_A 0 D_LED_PROXY
.model D_LED_PROXY D(IS=1e-20 N=2 RS=2 CJO=10p)

* Звуковая ветвь и резистивный эквивалент нагрузки зуммера.
VSA1 SOUND_EN 0 DC {5*SOUND_ENABLE}
.model SW_ENABLE SW(Ron=0.1 Roff=1e9 Vt=2.5 Vh=0.1)
R9 OUT R9_N 560
S_SA1 R9_N VT2_B SOUND_EN 0 SW_ENABLE
RBE VT2_B 0 1Meg
QVT2 BZ_COL VT2_B 0 Q_2N3904
RBZ VCC BZ_COL 166.7
D1 BZ_COL VCC D_CLAMP_PROXY
.model D_CLAMP_PROXY D(IS=1e-9 N=1.2 RS=0.2 CJO=20p BV=50 IBV=10u)

* Ветка HL2: светодиод и управляемый ключ включены последовательно.
* В исходном варианте ключ шунтировал светодиод. Это исправление требует SPICE-прогона.
R7 VCC HL2_A 220
VHL2_SENSE HL2_A HL2_DIN 0
D_HL2 HL2_DIN HL2_K D_LED_PROXY
S_HL2 HL2_K 0 SOUND_EN 0 SW_ENABLE

.control
set noaskquit
set wr_singlescale
set wr_vecnames
tran 0.1m 4.0
wrdata spice/vendor_model_results.dat v(S) v(UREF) v(DOUT) v(RESET) v(CT) v(OUT) v(BZ_COL)
meas tran t_reset_rise WHEN v(RESET)=2.5 RISE=1
meas tran t_alarm_first_rise WHEN v(OUT)=2.5 RISE=1
meas tran t_alarm_period TRIG v(OUT) VAL=2.5 RISE=2 TARG v(OUT) VAL=2.5 RISE=3
meas tran sensor_clean_air FIND v(S) AT=0.5
meas tran sensor_1000ppm FIND v(S) AT=1.2
meas tran sensor_5000ppm FIND v(S) AT=2.0
meas tran sensor_clean_air_after FIND v(S) AT=3.0
meas tran reset_air_initial FIND v(RESET) AT=0.5
meas tran reset_at_1000ppm FIND v(RESET) AT=1.2
meas tran reset_clean_after FIND v(RESET) AT=3.0
let modelled_current = -i(VCCSRC)
meas tran i_vendor_model_peak MAX modelled_current
let hl2_current = abs(i(VHL2_SENSE))
meas tran i_hl2_peak MAX hl2_current
quit
.endc
.end
